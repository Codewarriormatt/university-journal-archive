# Copy this file to server/.env and fill in your own values.
# Never commit server/.env.

# --- Server ---
PORT=4000
# development | production (production serves client/dist and sets Secure cookies = HTTPS only)
NODE_ENV=development

# --- Database (PostgreSQL 13+; needs the citext extension) ---
# Create the database first, e.g.:  createdb journal_archive
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/journal_archive

# --- Web / CORS ---
# Public URL of the frontend (used inside magic-link emails)
BASE_URL=http://localhost:5173
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# "true" only when running behind a trusted reverse proxy (Railway, Nginx, Caddy)
TRUST_PROXY=false

# --- First admin account (created automatically on first start when no admin exists) ---
# Required. The server will not create the admin without ADMIN_PASSWORD (min 8 characters).
# You will be asked to change the password at first login.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password

# --- Optional: email for reader magic-link sign-in (Brevo, free tier) ---
# Without it in development, the sign-in link is printed to the server console.
# Without it in production, reader sign-in returns "Email delivery is not set up" (503).
BREVO_API_KEY=
EMAIL_FROM=Journal Archive <noreply@example.com>
EMAIL_REPLY_TO=support@example.com

# --- Optional: AI journal insight (Anthropic, paid) ---
# Without it, the insight worker is disabled and the rest of the site works.
ANTHROPIC_API_KEY=
# How often the insight worker runs, in ms (default 300000 = 5 min)
# AI_INSIGHT_INTERVAL_MS=300000

# --- Optional: semantic search (OpenAI embeddings, paid) ---
# Without it, search falls back to keyword search.
OPENAI_API_KEY=

# --- Optional ---
# Folder for uploaded images and PDFs (default: server/uploads)
# UPLOADS_DIR=./uploads
# Allow "npm run seed" (wipes all data) when NODE_ENV=production
# SEED_ALLOWED=false

# Client (optional, file client/.env): API base URL when the API is on another host
# VITE_API_BASE_URL=
